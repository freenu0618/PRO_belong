# Model Path
MODEL_PATH=belong/ml/forecast_model.pkl

# Application Environment
APP_ENV=development

# Oracle Database (Legacy, if needed)
ORACLE_USER=scott
ORACLE_PASSWORD=tiger
ORACLE_DSN=localhost:1521/xe

# Ngrok (for external access)
NGROK_AUTHTOKEN=your-ngrok-authtoken-here

# RunPod API Configuration
RUNPOD_API_KEY=your-runpod-api-key-here
RUNPOD_ENDPOINT_URL=https://your-runpod-endpoint.proxy.runpod.net/generate

# PostgreSQL Database
DATABASE_URL=postgresql://username:password@localhost:5432/belong_db

# HuggingFace Token
HF_TOKEN=your-huggingface-token-here

# Flask Secret Keys
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=60

# Flask Debug Mode
FLASK_DEBUG=1
